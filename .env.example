# ---- Mama Vuna Fresh settings. Copy to .env and fill in. Never commit .env. ----

APP_ENV=production
APP_NAME=Mama Vuna Fresh
ORG_NAME=Ngwala Inventions

# Long random string. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to true once the site is served over HTTPS
SESSION_HTTPS_ONLY=true

# First administrator (created on first start only, when no users exist)
ADMIN_EMAIL=admin@yourdomain.co.tz
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator

# Database. SQLite file by default (fine for a district pilot). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://mamavuna:password@db:5432/mamavuna
DATABASE_URL=sqlite:////app/data/mamavuna.db

# ---- Telecom ----
# Your USSD code as allocated by the aggregator / TCRA
USSD_SERVICE_CODE=*149*77#
# Random string added to callback URLs: https://yourdomain/ussd?token=THIS
WEBHOOK_TOKEN=

# console = store SMS without sending (testing).  africastalking = send for real
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# Read-only partner API: send header  Authorization: Bearer <API_TOKEN>
API_TOKEN=

# ---- Programme rules ----
ALERT_LEAD_DAYS=21
ALERT_TIMEOUT_HOURS=24
RISK_START_WEEK=28
POSTPARTUM_DAYS=42
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MIN=15
WEEKLY_TIPS_ENABLED=true
TZ=Africa/Dar_es_Salaam
